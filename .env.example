# Token de autenticação do Bot Discord
DISCORD_TOKEN=seu_discord_bot_token_aqui
DISCORD_CLIENT_ID=seu_client_id_aqui

# Prefixo Padrão dos Comandos
DEFAULT_PREFIX=$

# Configurações do Banco de Dados PostgreSQL
DATABASE_URL=postgresql://arqon_user:arqon_secret_password@localhost:5432/arqon_db

# Configurações do Redis (Cache, Locks Atômicos e Filas)
REDIS_URL=redis://:arqon_redis_pass@localhost:6379

# Ambiente (development | production)
NODE_ENV=development

# Configurações de Log
LOG_LEVEL=info
