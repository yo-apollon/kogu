# --- Discord ---
DISCORD_TOKEN=seu_discord_bot_token_aqui
DISCORD_CLIENT_ID=seu_client_id_aqui
# Servidor de desenvolvimento: slash commands registrados aqui sao instantaneos
DEV_GUILD_ID=
# IDs de usuarios Discord (separados por virgula) com acesso a comandos de dono ($setvip, $adminreset, catalogo)
OWNER_IDS=
DEFAULT_PREFIX=$

# --- PostgreSQL ---
POSTGRES_USER=arqon_user
POSTGRES_DB=arqon_db
POSTGRES_PASSWORD=troque_esta_senha
DATABASE_URL=postgresql://arqon_user:troque_esta_senha@localhost:5432/arqon_db

# --- Redis ---
REDIS_PASSWORD=troque_esta_senha_redis
REDIS_URL=redis://:troque_esta_senha_redis@localhost:6379

# --- Catalogo rotativo (opcionais: fonte desativada se vazio) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TMDB_API_KEY=

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
HEALTH_PORT=8080

# --- Sites (catalogo publico) ---
# Pastas de destino do site:export (separadas por ponto e virgula); vazio = ./docs
SITE_EXPORT_DIRS=
# Repositorios dos sites para site:publish (separados por ponto e virgula). Dry-run por padrao; exige --yes.
SITE_PUBLISH_REPOS=
