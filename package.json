{
  "name": "arqon-bot",
  "version": "2.0.0",
  "description": "Arqon - RPG Dimensional de Gacha e Colecionismo para Discord",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsx watch src/index.ts",
    "dev:bot": "tsx watch src/index.ts",
    "dev:local": "tsx src/scripts/devLocal.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infra/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "migrate:sqlite": "tsx src/scripts/migrateFromSqlite.ts",
    "catalog:expand": "tsx src/scripts/expandCatalog1000.ts",
    "sync:once": "tsx src/scripts/syncOnce.ts",
    "catalog:bootstrap": "tsx src/scripts/catalogBootstrap.ts",
    "deploy:commands": "tsx src/scripts/deployCommands.ts",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --project unit --passWithNoTests",
    "test:perf": "node scripts/test-perf.mjs",
    "test:int":"vitest run --project integration --passWithNoTests"
  },
  "dependencies": {
    "@discordjs/rest": "^2.4.0",
    "@napi-rs/canvas": "^0.1.58",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^5.34.0",
    "discord-api-types": "^0.37.104",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "ioredis": "^5.4.1",
    "lru-cache": "^11.0.2",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "piscina": "^4.8.0",
    "postgres": "^3.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.5.5",
    "drizzle-kit": "^0.24.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
