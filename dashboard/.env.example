# Copie para .env.local. Nunca commite valores reais.
# Segredo do Auth.js (min. 16 caracteres; gere com `npx auth secret`)
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# true quando a app roda atras de proxy fora da Vercel (confia no header Host)
AUTH_TRUST_HOST=
# Papel somente leitura (dashboard_ro); pooler do Supabase em modo transacao
DATABASE_URL_RO=
# Papel de escrita restrita (dashboard_rw); usado so em Server Actions
DATABASE_URL_RW=
# IDs Discord dos donos (area de staff), separados por virgula
OWNER_IDS=
NEXT_PUBLIC_APP_URL=http://localhost:3000
